<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- IsAotCompatible is deliberately not set: IStoredTableDataSet is an IQueryable,
         and in-memory AsQueryable() requires dynamic code (IL2026 / IL3050). -->
    <!-- Enable once the first tag is published:
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>…</PackageValidationBaselineVersion> -->
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>Pure.RelationalSchema.Storage.Samples</PackageId>
    <RootNamespace>Pure.RelationalSchema.Storage.Samples</RootNamespace>
    <AssemblyName>Pure.RelationalSchema.Storage.Samples</AssemblyName>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kudima03/Pure.RelationalSchema.Storage.Samples</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pure.Collections.Generic" Version="0.1.0-preview.3.0.0" />
    <PackageReference Include="Pure.Primitives" Version="3.6.5" />
    <PackageReference Include="Pure.RelationalSchema.HashCodes" Version="3.3.0" />
    <PackageReference Include="Pure.RelationalSchema.Samples" Version="0.1.0-preview.0.1.0" />
    <PackageReference
      Include="Pure.RelationalSchema.Storage.Abstractions"
      Version="0.1.0-preview.4.1.0"
    />
  </ItemGroup>
</Project>
